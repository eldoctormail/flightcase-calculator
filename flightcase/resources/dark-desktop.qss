/* LBD Flightcase Maker: tema oscuro azul marino.
   Colores: fondo #0f1626, paneles #141d30, superficies #1b2640, bordes #26334f,
   texto #e6ecf7, texto suave #8b97b0, acento #3b82f6, marca #f5a524. */

* {
  font-size: 10pt;
  color: #e6ecf7;
  outline: none;
}

QWidget {
  background-color: #0f1626;
}

QMainWindow, QDialog {
  background-color: #0f1626;
}

QLabel, QCheckBox, QRadioButton {
  background-color: transparent;
}

QToolTip {
  background-color: #1b2640;
  color: #e6ecf7;
  border: 1px solid #33456b;
  padding: 4px;
}

/* ---------------------------------------------------------------- cabecera y barra lateral */

QFrame#cabecera {
  background-color: #0b1120;
  border-bottom: 1px solid #1f2a42;
}

QLabel#marca {
  font-size: 13pt;
  padding-right: 10px;
}

QLabel#archivo {
  color: #aab5cc;
  padding: 3px 8px;
}

QFrame#lateral {
  background-color: #0b1120;
  border-right: 1px solid #1f2a42;
}

QToolButton#botonLateral {
  background-color: transparent;
  border: none;
  border-radius: 6px;
  padding: 5px 2px 4px 2px;
  color: #8b97b0;
  font-size: 8pt;
}

QToolButton#botonLateral:hover {
  background-color: #17213a;
  color: #e6ecf7;
}

QToolButton#botonLateral:checked {
  background-color: #1d3460;
  color: #ffffff;
}

QFrame#panelIzq, QFrame#panelIzq QScrollArea, QWidget#pagina, QFrame#cajaEstilo {
  background-color: #111a2c;
}

QFrame#panelIzq {
  border-right: 1px solid #1f2a42;
}

QLabel#tituloPanel {
  font-size: 12pt;
  font-weight: 600;
  padding: 10px 10px 2px 10px;
  background-color: #111a2c;
}

QLabel#tituloSeccion {
  font-weight: 600;
  color: #e6ecf7;
  padding: 10px 0px 3px 0px;
  border-bottom: 1px solid #22304c;
  margin-bottom: 2px;
}

QToolButton#botonConfig {
  color: #8b97b0;
  background-color: transparent;
  border: 1px solid #26334f;
  border-radius: 5px;
  padding: 2px 6px;
  margin-bottom: 3px;
}

QToolButton#botonConfig:hover {
  color: #e6ecf7;
  border-color: #3b82f6;
}

QToolButton#botonConfig::menu-indicator {
  image: none;
}

QLabel#nota {
  color: #8b97b0;
  font-style: italic;
}

QLabel#resumen {
  color: #aab5cc;
  padding: 2px 4px;
}

QLabel#avisos {
  color: #f0b44c;
  padding: 2px 4px;
}

/* barra de datos bajo la vista 3D */
QFrame#barraDatos {
  background-color: #0e1526;
  border-top: 1px solid #1f2a42;
}

QLabel#datoTitulo {
  color: #6f7c96;
  font-size: 8pt;
}

QLabel#datoValor {
  color: #e6ecf7;
  font-weight: 600;
}

QLabel#chip {
  background-color: #17213a;
  color: #aab5cc;
  border: 1px solid #26334f;
  border-radius: 10px;
  padding: 2px 10px;
}

QPushButton#chipAviso {
  background-color: #17213a;
  border: 1px solid #26334f;
  border-radius: 10px;
  padding: 3px 12px;
  color: #6fd39b;
}

QPushButton#chipAviso[hay="true"] {
  color: #f5a524;
  border-color: #6b4a12;
}

/* ---------------------------------------------------------------- botones y campos */

QPushButton {
  background-color: #1b2640;
  border: 1px solid #26334f;
  border-radius: 5px;
  padding: 4px 10px;
}

QPushButton:hover {
  background-color: #23314f;
  border-color: #34466c;
}

QPushButton:pressed {
  background-color: #2b3c60;
}

QPushButton:checked {
  background-color: #1d3460;
  border-color: #3b82f6;
  color: #ffffff;
}

QPushButton:disabled {
  color: #56627a;
  background-color: #151e33;
  border-color: #1f2a42;
}

QPushButton#principal, QPushButton[accent="1"] {
  background-color: #2f6fe4;
  border: 1px solid #3b82f6;
  color: #ffffff;
  font-weight: 600;
}

QPushButton#principal:hover, QPushButton[accent="1"]:hover {
  background-color: #3b82f6;
}

QPushButton#botonTapa {
  padding: 3px 8px;
  font-size: 9pt;
}

QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QDateEdit, QTimeEdit, QDateTimeEdit, QComboBox {
  background-color: #182238;
  border: 1px solid #26334f;
  border-radius: 4px;
  padding: 3px 6px;
  selection-background-color: #2f6fe4;
}

QLineEdit:hover, QTextEdit:hover, QPlainTextEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover, QComboBox:hover {
  border-color: #34466c;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
  border-color: #3b82f6;
}

QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled, QComboBox:disabled {
  color: #56627a;
}

QSpinBox::up-button, QSpinBox::down-button, QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
  background-color: #1f2a44;
  border: none;
  width: 14px;
}

QComboBox::drop-down {
  border: none;
  width: 18px;
}

QComboBox QAbstractItemView {
  background-color: #182238;
  border: 1px solid #33456b;
  selection-background-color: #2f6fe4;
}

QCheckBox, QRadioButton {
  spacing: 6px;
  padding: 2px 0px;
}

QCheckBox::indicator, QGroupBox::indicator, QRadioButton::indicator {
  width: 14px;
  height: 14px;
  border: 1px solid #3a4a6c;
  background-color: #182238;
  border-radius: 3px;
}

QRadioButton::indicator {
  border-radius: 7px;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
  border-color: #3b82f6;
}

QCheckBox::indicator:checked, QGroupBox::indicator:checked, QRadioButton::indicator:checked {
  background-color: #3b82f6;
  border-color: #60a5fa;
}

QCheckBox::indicator:indeterminate {
  background-color: #2b3c60;
}

QCheckBox:disabled, QRadioButton:disabled {
  color: #56627a;
}

/* ---------------------------------------------------------------- pestañas */

QTabWidget::pane {
  border: 1px solid #1f2a42;
  border-radius: 4px;
  top: -1px;
  background-color: #0f1626;
}

QTabBar::tab {
  background-color: transparent;
  color: #8b97b0;
  padding: 6px 12px;
  border: none;
  border-bottom: 2px solid transparent;
}

QTabBar::tab:hover {
  color: #e6ecf7;
}

QTabBar::tab:selected {
  color: #ffffff;
  border-bottom: 2px solid #3b82f6;
}

QGroupBox {
  border: 1px solid #26334f;
  border-radius: 5px;
  margin-top: 12px;
  padding-top: 6px;
}

QGroupBox::title {
  subcontrol-origin: margin;
  left: 8px;
  padding: 0 4px;
  color: #aab5cc;
}

QSplitter::handle {
  background-color: #1a2440;
}

QSplitter::handle:hover {
  background-color: #3b82f6;
}

/* ---------------------------------------------------------------- listas y tablas */

QAbstractItemView, QListView, QTreeView, QTableView {
  background-color: #121b2e;
  alternate-background-color: #151f34;
  border: 1px solid #1f2a42;
  gridline-color: #1f2a42;
  selection-background-color: #24407a;
  selection-color: #ffffff;
}

QAbstractItemView::item:hover {
  background-color: #1a2742;
}

QAbstractItemView::item:selected {
  background-color: #24407a;
}

QHeaderView, QHeaderView::section {
  background-color: #17213a;
  color: #aab5cc;
  border: none;
  border-right: 1px solid #1f2a42;
  border-bottom: 1px solid #1f2a42;
  padding: 4px 6px;
}

QAbstractItemView QTableCornerButton::section {
  background-color: #17213a;
  border: none;
}

QProgressBar {
  background-color: #182238;
  border: 1px solid #26334f;
  border-radius: 4px;
  text-align: center;
}

QProgressBar::chunk {
  background-color: #3b82f6;
  border-radius: 3px;
}

/* ---------------------------------------------------------------- barras de desplazamiento */

QScrollBar:vertical {
  background: transparent;
  width: 10px;
  margin: 0px;
}

QScrollBar:horizontal {
  background: transparent;
  height: 10px;
  margin: 0px;
}

QScrollBar::handle {
  background-color: #2a3756;
  border-radius: 4px;
  min-height: 24px;
  min-width: 24px;
  margin: 1px;
}

QScrollBar::handle:hover {
  background-color: #3a4a6c;
}

QScrollBar::add-line, QScrollBar::sub-line, QScrollBar::add-page, QScrollBar::sub-page {
  background: transparent;
  border: none;
  width: 0px;
  height: 0px;
}

/* ---------------------------------------------------------------- deslizadores */

QSlider {
  background: transparent;
  min-height: 18px;
}

QSlider::groove:horizontal {
  height: 4px;
  background-color: #26334f;
  border-radius: 2px;
}

QSlider::sub-page:horizontal {
  background-color: #3b82f6;
  border-radius: 2px;
}

QSlider::handle:horizontal {
  background-color: #e6ecf7;
  border: 2px solid #3b82f6;
  width: 10px;
  height: 10px;
  margin: -5px 0px;
  border-radius: 7px;
}

QSlider::groove:vertical {
  width: 4px;
  background-color: #26334f;
  border-radius: 2px;
}

QSlider::handle:vertical {
  background-color: #e6ecf7;
  border: 2px solid #3b82f6;
  width: 10px;
  height: 10px;
  margin: 0px -5px;
  border-radius: 7px;
}

/* ---------------------------------------------------------------- menús */

QMenuBar {
  background-color: #0b1120;
  border-bottom: 1px solid #1f2a42;
}

QMenuBar::item {
  background: transparent;
  padding: 4px 10px;
}

QMenuBar::item:selected, QMenuBar::item:pressed {
  background-color: #1b2640;
  border-radius: 4px;
}

QMenu {
  background-color: #141d30;
  border: 1px solid #2a3756;
  padding: 4px;
}

QMenu::item {
  background: transparent;
  padding: 5px 24px 5px 20px;
  border-radius: 4px;
}

QMenu::item:selected {
  background-color: #24407a;
}

QMenu::item:disabled {
  color: #56627a;
}

QMenu::separator {
  height: 1px;
  background-color: #26334f;
  margin: 4px 8px;
}

QStatusBar {
  background-color: #0b1120;
  color: #8b97b0;
  border-top: 1px solid #1f2a42;
}

QStatusBar QLabel {
  color: #8b97b0;
}

/* ---------------------------------------------------------------- QToolBox (otros diálogos) */

QToolBox::tab {
  background-color: #17213a;
  border-radius: 4px;
  padding: 3px 8px;
  color: #aab5cc;
}

QToolBox::tab:selected {
  background-color: #1d3460;
  color: #ffffff;
}

/* ---------------------------------------------------------------- barra de la vista 3D */

QFrame#barra3d {
  background-color: #111a2c;
  border-bottom: 1px solid #1f2a42;
}

QFrame#barra3d QToolButton {
  background-color: transparent;
  border: 1px solid transparent;
  border-radius: 5px;
  padding: 3px;
}

QFrame#barra3d QToolButton:hover {
  background-color: #1b2640;
  border-color: #26334f;
}

QFrame#barra3d QToolButton:checked {
  background-color: #1d3460;
  border-color: #3b82f6;
}

/* ---------------------------------------------------------------- pantalla de inicio */

QDialog#pantallaInicio {
  background-color: #0f1626;
}

QFrame#navInicio {
  background-color: #0b1120;
  border-right: 1px solid #1f2a42;
}

QLabel#marcaInicio {
  font-size: 14pt;
  font-weight: 700;
}

QToolButton#botonNavInicio {
  background-color: transparent;
  border: 1px solid transparent;
  border-radius: 6px;
  padding: 7px 8px;
  text-align: left;
  color: #aab5cc;
}

QToolButton#botonNavInicio:hover {
  background-color: #17213a;
  color: #e6ecf7;
}

QToolButton#botonNavInicio:checked {
  background-color: #1d3460;
  border-color: #2f5bb0;
  color: #ffffff;
}

QFrame#centroInicio, QWidget#paginaInicio, QScrollArea#scrollInicio {
  background-color: #0f1626;
}

QLabel#tituloInicio {
  font-size: 20pt;
  font-weight: 700;
}

QLabel#subtituloInicio {
  color: #8b97b0;
}

QFrame#campoNombre {
  background-color: #141d30;
  border: 1px solid #26334f;
  border-radius: 6px;
}

QLineEdit#nombreProyecto {
  background-color: transparent;
  border: none;
  padding: 0px;
  font-size: 10.5pt;
}

QPushButton#pestanaInicio {
  padding: 6px 12px;
  border-radius: 6px;
}

QPushButton#pestanaInicio:checked {
  background-color: #2f6fe4;
  border-color: #3b82f6;
}

QFrame#tarjetaInicio {
  background-color: #141d30;
  border: 1px solid #22304c;
  border-radius: 8px;
}

QFrame#tarjetaInicio:hover {
  border-color: #34466c;
}

QFrame#tarjetaInicio[elegida="true"] {
  border: 1px solid #3b82f6;
  background-color: #16223a;
}

QFrame#tarjetaInicio QWidget#chipsTarjeta, QFrame#tarjetaInicio QLabel {
  background-color: transparent;
}

QFrame#tarjetaInicio QLabel#imagenTarjeta {
  background-color: qradialgradient(cx:0.5, cy:0.45, radius:0.75, fx:0.5, fy:0.4,
                                    stop:0 #2a4378, stop:1 #141d30);
  border-top-left-radius: 8px;
  border-top-right-radius: 8px;
}

QFrame#tarjetaInicio QLabel#marcaElegida {
  background-color: #3b82f6;
  border-radius: 11px;
}

QLabel#tituloTarjeta {
  font-weight: 600;
  padding-top: 4px;
}

QLabel#textoTarjeta {
  color: #8b97b0;
  font-size: 9pt;
}

QPushButton#chipEstilo {
  background-color: #182238;
  border: 1px solid #26334f;
  border-radius: 9px;
  padding: 2px 8px;
  font-size: 8.5pt;
  color: #aab5cc;
}

QPushButton#chipEstilo:hover {
  border-color: #3b82f6;
  color: #e6ecf7;
}

QPushButton#chipEstilo:checked {
  background-color: #1d3460;
  border-color: #3b82f6;
  color: #ffffff;
}

QFrame#previaInicio {
  background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #13203a, stop:1 #0d1424);
  border-left: 1px solid #1f2a42;
}

QLabel#tituloPrevia {
  font-size: 15pt;
  font-weight: 700;
}

QLabel#imagenPrevia {
  background-color: qradialgradient(cx:0.5, cy:0.5, radius:0.6, fx:0.5, fy:0.5,
                                    stop:0 #24407a, stop:1 transparent);
}

QLabel#familiaPrevia {
  color: #3b82f6;
  font-size: 8pt;
  font-weight: 600;
}

QLabel#nombrePrevia {
  font-size: 12pt;
  font-weight: 600;
}

QFrame#lineaPrevia {
  background-color: #26334f;
}

QFrame#pieInicio {
  background-color: #0f1626;
  border-top: 1px solid #1f2a42;
}

/* ---------------------------------------------------------------- sección de medidas */

QLabel#subtituloMedidas {
  font-weight: 600;
  color: #e6ecf7;
  padding: 8px 0px 2px 0px;
}

QLabel#etiquetaCampo {
  color: #8b97b0;
  padding-top: 4px;
}

QLabel#notaMedidas {
  color: #aab5cc;
  padding-top: 8px;
}

QToolButton#candado {
  background-color: #182238;
  border: 1px solid #26334f;
  border-radius: 5px;
  padding: 4px;
}

QToolButton#candado:checked {
  background-color: #1d3460;
  border-color: #3b82f6;
}

QDoubleSpinBox#medida, QComboBox#medicion {
  padding: 2px 8px;
  min-height: 26px;
  border-radius: 6px;
  background-color: #0f1626;
}

QDoubleSpinBox#medida:focus, QComboBox#medicion:focus {
  border-color: #3b82f6;
}

QDoubleSpinBox#medida::up-button, QDoubleSpinBox#medida::down-button {
  width: 0px;
  border: none;
}
